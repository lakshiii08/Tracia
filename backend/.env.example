# Server Port
PORT=5000

# MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017/tracia
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/tracia
MONGODB_URI=mongodb://localhost:27017/tracia

# JWT Secret Key
JWT_SECRET=tracia-super-secret-jwt-key-2026-production

# JWT Expiration Time (e.g. 8h, 24h)
JWT_EXPIRES_IN=8h

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000
