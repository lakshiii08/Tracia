# =========================================================
# TRACIA Platform Environment & Backend Configuration
# =========================================================

# Mock Data Control: set to 'false' to route calls to live backend
NEXT_PUBLIC_USE_MOCK_DATA=true

# Public API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Terminal & Workspace Identity
NEXT_PUBLIC_TERMINAL_ID=ALPHA_77
NEXT_PUBLIC_REGION_ID=REGION-04

# Authentication JWT Secret (Keep identical across cluster nodes)
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Core FastAPI / Microservices Backend URL
FASTAPI_BACKEND_URL=http://localhost:8000

# Neo4j Graph Database Connection (Bolt Protocol)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# AI Copilot & GraphRAG Service URL
GRAPHRAG_LLM_URL=http://localhost:8000/api/graphrag

# Permissioned Blockchain RPC Node / Service URL
BLOCKCHAIN_RPC_URL=http://localhost:8545
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://localhost:8545
NEXT_PUBLIC_HARDHAT_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
EVIDENCE_REGISTRY_CONTRACT_ADDRESS=
NEXT_PUBLIC_EVIDENCE_REGISTRY_CONTRACT_ADDRESS=
BLOCKCHAIN_NETWORK_NAME=Configured Evidence Ledger
BLOCKCHAIN_SERVICE_URL=
BLOCKCHAIN_EXPLORER_TX_BASE_URL=
EVIDENCE_LEDGER_REGISTERED_BY=TRACIA_SYSTEM

# Database Path for SQLite operational fallback
SQLITE_DB_PATH=./data/tracia.db
